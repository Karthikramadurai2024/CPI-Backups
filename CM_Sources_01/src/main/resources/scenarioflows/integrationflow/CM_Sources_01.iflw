                <di:waypoint x="432.0" xsi:type="dc:Point" y="132.0"/>
                <di:waypoint x="590.0" xsi:type="dc:Point" y="132.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_3563375" id="BPMNEdge_SequenceFlow_3563375" sourceElement="BPMNShape_StartEvent_3563374" targetElement="BPMNShape_CallActivity_4">
