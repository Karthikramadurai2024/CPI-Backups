        &lt;Name&gt;Ravi&lt;/Name&gt;
        &lt;Department&gt;IT&lt;/Department&gt;
        &lt;Location&gt;Bangalore&lt;/Location&gt;
        &lt;Salary&gt;60000&lt;/Salary&gt;
        &lt;Status&gt;Active&lt;/Status&gt;
    &lt;/Employee&gt;
&lt;/Employees&gt;</value>
