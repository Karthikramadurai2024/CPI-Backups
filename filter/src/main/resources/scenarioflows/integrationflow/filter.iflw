    &lt;Employee&gt;
        &lt;EmployeeID&gt;102&lt;/EmployeeID&gt;
        &lt;Name&gt;Priya&lt;/Name&gt;
        &lt;Department&gt;HR&lt;/Department&gt;
        &lt;Location&gt;Bangalore&lt;/Location&gt;
        &lt;Salary&gt;40000&lt;/Salary&gt;
        &lt;Status&gt;Active&lt;/Status&gt;
    &lt;/Employee&gt;

