                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;Employees&gt;
    &lt;Employee&gt;
        &lt;EmployeeID&gt;101&lt;/EmployeeID&gt;
        &lt;Name&gt;Arun&lt;/Name&gt;
