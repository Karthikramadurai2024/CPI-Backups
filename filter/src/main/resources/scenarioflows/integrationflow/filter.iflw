        &lt;Name&gt;Kumar&lt;/Name&gt;
        &lt;Department&gt;IT&lt;/Department&gt;
        &lt;Location&gt;Chennai&lt;/Location&gt;
        &lt;Salary&gt;55000&lt;/Salary&gt;
