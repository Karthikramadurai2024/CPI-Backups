	xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" 
	xmlns:sup="http://sim.aravo.com/soapservices/v4_2/SupplierService"&gt;
   &lt;soapenv:Header/&gt;
   &lt;soapenv:Body&gt;
      &lt;sup:getSuppliers&gt;
         &lt;request&gt;
            &lt;!-- optional, include contact links --&gt;
            &lt;includeEntityTypes&gt;Contact&lt;/includeEntityTypes&gt;
            &lt;!-- optional, include location links --&gt;
            &lt;includeEntityTypes&gt;Location&lt;/includeEntityTypes&gt;
            &lt;!-- optional, include business relationship links --&gt;
            &lt;includeEntityTypes&gt;Br&lt;/includeEntityTypes&gt;
            &lt;!-- optional, include supplier extended attributes --&gt;
            &lt;includeEntityTypes&gt;SupplierExtendedAttribute&lt;/includeEntityTypes&gt;
            &lt;sid&gt;${property.supplierId}&lt;/sid&gt;
            &lt;sidType&gt;internalId&lt;/sidType&gt;
         &lt;/request&gt;
      &lt;/sup:getSuppliers&gt;
   &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;</value>
