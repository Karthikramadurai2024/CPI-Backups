   &lt;iFlowMessageId&gt;${property.SAP_MessageProcessingLogID}&lt;/iFlowMessageId&gt;
   &lt;Event&gt;${camelId}&lt;/Event&gt;
   &lt;LogStart&gt;${date:exchangeCreated:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}&lt;/LogStart&gt;
   &lt;LogEnd&gt;${date:now:yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}&lt;/LogEnd&gt;
   &lt;SourceIdentifier&gt;&lt;/SourceIdentifier&gt;
   &lt;Transaction&gt;
     &lt;Message&gt;&lt;![CDATA[${exception.message}]]&gt;&lt;/Message&gt;
     &lt;Status&gt;ERROR&lt;/Status&gt;
     &lt;RequestPayload&gt;
{
"supplierId": "${header.SAP_ApplicationID}",
"supplierName": "${header.SupplierName}",
"siteId": "${property.aravositeId}",
"businessProcessId": "${header.BusinessProcessId}"
}
     &lt;/RequestPayload&gt;
     &lt;Code&gt;${header.CamelHttpResponseCode}&lt;/Code&gt;
  &lt;/Transaction&gt;
&lt;/CEF&gt;</value>
