        <bpmn2:callActivity id="CallActivity_5" name="Details Capturing">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//start&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;welcome&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//title&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;headerchange&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//subject&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;subject&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;!DOCTYPE html&gt;

&lt;html&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;title&gt;${property.headerchange}&lt;/title&gt;
&lt;/head&gt;

&lt;body style="margin:0; padding:0; background-color:#eef3f8; font-family:Arial, sans-serif;"&gt;

```
&lt;table width="100%" cellpadding="0" cellspacing="0" border="0"&gt;
    &lt;tr&gt;
        &lt;td align="center" style="padding:40px 10px;"&gt;

            &lt;table width="600" cellpadding="0" cellspacing="0" border="0"
                   style="background-color:#ffffff;"&gt;

                &lt;!-- Top Banner --&gt;
                &lt;tr&gt;
                    &lt;td style="background-color:#6a1b9a; padding:30px; text-align:center;"&gt;
                        &lt;h1 style="color:#ffffff; margin:0;"&gt;
                            Integration Report
                        &lt;/h1&gt;
                        &lt;p style="color:#e1bee7; margin:10px 0 0;"&gt;
                            SAP Cloud Integration
                        &lt;/p&gt;
                    &lt;/td&gt;
                &lt;/tr&gt;

                &lt;!-- Main Content --&gt;
                &lt;tr&gt;
                    &lt;td style="padding:30px;"&gt;

                        &lt;h2 style="color:#333333;"&gt;
                            ${property.welcome}
                        &lt;/h2&gt;

                        &lt;p style="font-size:15px; color:#555555; line-height:1.7;"&gt;
                            The integration process has been completed successfully.
                            This email has been generated automatically from SAP CPI
                            to test the Mail Adapter and HTML message formatting.
                        &lt;/p&gt;

                        &lt;!-- Highlight Box --&gt;
                        &lt;table width="100%" cellpadding="15" cellspacing="0" border="0"
                               style="background-color:#fff3e0; border-radius:6px;"&gt;
                            &lt;tr&gt;
                                &lt;td&gt;
                                    &lt;span style="color:#ef6c00; font-size:18px;"&gt;
                                        ●
                                    &lt;/span&gt;
                                    &lt;b style="color:#e65100;"&gt;
                                        Integration Completed
                                    &lt;/b&gt;
                                    &lt;p style="margin:8px 0 0; color:#666666;"&gt;
                                        All messages were processed successfully.
                                    &lt;/p&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                        &lt;/table&gt;

                        &lt;br&gt;

                        &lt;!-- Information Table --&gt;
                        &lt;h3 style="color:#6a1b9a;"&gt;
                            Process Information
                        &lt;/h3&gt;

                        &lt;table width="100%" cellpadding="12" cellspacing="0"
                               style="border-collapse:collapse;"&gt;

                            &lt;tr style="background-color:#6a1b9a; color:white;"&gt;
                                &lt;th align="left"&gt;Parameter&lt;/th&gt;
                                &lt;th align="left"&gt;Details&lt;/th&gt;
                            &lt;/tr&gt;

                            &lt;tr style="background-color:#f8f8f8;"&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Integration Flow
                                &lt;/td&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Mail Adapter Test
                                &lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Sender
                                &lt;/td&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    SAP CPI
                                &lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr style="background-color:#f8f8f8;"&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Receiver
                                &lt;/td&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Email Server
                                &lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    Status
                                &lt;/td&gt;
                                &lt;td style="border-bottom:1px solid #dddddd;"&gt;
                                    &lt;b style="color:#2e7d32;"&gt;
                                        SUCCESS
                                    &lt;/b&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;

                        &lt;/table&gt;

                        &lt;br&gt;

                        &lt;!-- Message --&gt;
                        &lt;div style="background-color:#e3f2fd; padding:15px;
                                    border-left:4px solid #1565c0;"&gt;

                            &lt;p style="margin:0; color:#1565c0;"&gt;
                                &lt;b&gt;Test Message:&lt;/b&gt;
                            &lt;/p&gt;

                            &lt;p style="margin:8px 0 0; color:#555555;"&gt;
                                If this email is displayed with the correct colors,
                                formatting, and table structure, the HTML Mail Adapter
                                test is working correctly.
                            &lt;/p&gt;

                        &lt;/div&gt;

                        &lt;br&gt;

                        &lt;p style="color:#777777; font-size:13px;"&gt;
                            Thank you,&lt;br&gt;
                            &lt;b&gt;SAP Integration Team&lt;/b&gt;
                        &lt;/p&gt;

                    &lt;/td&gt;
                &lt;/tr&gt;

                &lt;!-- Footer --&gt;
                &lt;tr&gt;
                    &lt;td style="background-color:#37474f; padding:18px; text-align:center;"&gt;
                        &lt;p style="color:#ffffff; margin:0;"&gt;
                            SAP CPI | Integration Testing
                        &lt;/p&gt;

                        &lt;p style="color:#b0bec5; font-size:11px; margin:6px 0 0;"&gt;
                            Automated notification - Please do not reply.
                        &lt;/p&gt;
                    &lt;/td&gt;
                &lt;/tr&gt;

            &lt;/table&gt;

        &lt;/td&gt;
    &lt;/tr&gt;
&lt;/table&gt;
```

