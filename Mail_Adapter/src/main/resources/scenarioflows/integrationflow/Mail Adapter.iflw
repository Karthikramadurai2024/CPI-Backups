        <bpmn2:callActivity id="CallActivity_5" name="Message Payload">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//h3&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;details&lt;/cell&gt;&lt;cell id='Datatype'&gt;string&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//span&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;statusinfo&lt;/cell&gt;&lt;cell id='Datatype'&gt;string&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//h1&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;changeheader&lt;/cell&gt;&lt;cell id='Datatype'&gt;string&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//td&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;header&lt;/cell&gt;&lt;cell id='Datatype'&gt;string&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//status&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;status&lt;/cell&gt;&lt;cell id='Datatype'&gt;string&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;&amp;lt;html&amp;gt; &amp;lt;body&amp;gt; &amp;lt;p&amp;gt; Hello, this is a test email sent from SAP Cloud Integration using the Mail Adapter.  This email is being sent to verify that the mail adapter configuration and message flow are working correctly.  If you have received this email, the SAP CPI Mail Adapter has successfully processed and delivered the message. &amp;lt;/p&amp;gt; &amp;lt;/body&amp;gt; &amp;lt;/html&amp;gt;&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Attachment&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;!DOCTYPE html&gt;

&lt;html&gt;


&lt;body style="margin:0; padding:0; background-color:#f2f4f7; font-family:Arial, sans-serif;"&gt;

```
&lt;table width="100%" cellpadding="0" cellspacing="0" border="0"&gt;
    &lt;tr&gt;
        &lt;td align="center" style="padding:30px 10px;"&gt;

            &lt;table width="650" cellpadding="0" cellspacing="0" border="0"
                   style="background-color:#ffffff; border-radius:10px;"&gt;

                &lt;!-- Header --&gt;
                &lt;tr&gt;
                    &lt;td style="background-color:#1976d2; padding:25px; text-align:center;"&gt;
                        &lt;h1 style="color:#ffffff; margin:0;"&gt;${property.changeheader}
                        &lt;/h1&gt;
                        &lt;p style="color:#e3f2fd; margin:8px 0 0;"&gt;
                            Mail Adapter Test
                        &lt;/p&gt;
                    &lt;/td&gt;
                &lt;/tr&gt;

                &lt;!-- Content --&gt;
                &lt;tr&gt;
                    &lt;td style="padding:25px;"&gt;

                        &lt;h2 style="color:#1976d2;"&gt;
                            Hello,
                        &lt;/h2&gt;

                        &lt;p style="color:#444444; font-size:15px; line-height:1.6;"&gt;
                            This is a test email generated from SAP Cloud Integration.
                            The purpose of this message is to verify that the Mail Adapter
                            is working correctly and that HTML formatting is supported.
                        &lt;/p&gt;

                        &lt;!-- Status --&gt;
                        &lt;table width="100%" cellpadding="10" cellspacing="0" border="0"
                               style="background-color:#e8f5e9; border-left:5px solid #2e7d32;"&gt;
                            &lt;tr&gt;
                                &lt;td&gt;
                                    &lt;b style="color:#2e7d32;"&gt;STATUS: ${property.status}&lt;/b&gt;
                                    &lt;br&gt;
                                    &lt;span style="color:#555555;"&gt; ${property.statusinfo}
                                    &lt;/span&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;
                        &lt;/table&gt;

                        &lt;br&gt;

                        &lt;!-- Details Table --&gt;
                        &lt;h3 style="color:#333333;"&gt;
                            ${property.details}
                        &lt;/h3&gt;

                        &lt;table width="100%" cellpadding="12" cellspacing="0" border="1"
                               style="border-collapse:collapse; border-color:#dddddd;"&gt;

                            &lt;tr style="background-color:#1976d2; color:#ffffff;"&gt;
                                &lt;th&gt;Field&lt;/th&gt;
                                &lt;th&gt;Value&lt;/th&gt;
                            &lt;/tr&gt;

                            &lt;tr&gt;
                                &lt;td&gt;&lt;b&gt;System&lt;/b&gt;&lt;/td&gt;
                                &lt;td&gt;${property.header}&lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr style="background-color:#f7f9fc;"&gt;
                                &lt;td&gt;&lt;b&gt;Adapter&lt;/b&gt;&lt;/td&gt;
                                &lt;td&gt;Mail Adapter&lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr&gt;
                                &lt;td&gt;&lt;b&gt;Message Type&lt;/b&gt;&lt;/td&gt;
                                &lt;td&gt;HTML Email&lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr style="background-color:#f7f9fc;"&gt;
                                &lt;td&gt;&lt;b&gt;Environment&lt;/b&gt;&lt;/td&gt;
                                &lt;td&gt;Test&lt;/td&gt;
                            &lt;/tr&gt;

                            &lt;tr&gt;
                                &lt;td&gt;&lt;b&gt;Result&lt;/b&gt;&lt;/td&gt;
                                &lt;td style="color:#2e7d32;"&gt;
                                    &lt;b&gt;Successful&lt;/b&gt;
                                &lt;/td&gt;
                            &lt;/tr&gt;

                        &lt;/table&gt;

                        &lt;br&gt;

                        &lt;p style="color:#555555; font-size:14px;"&gt;
                            If you received this email with the colors and table
                            displayed correctly, your HTML email configuration
                            is working as expected.
                        &lt;/p&gt;

                    &lt;/td&gt;
                &lt;/tr&gt;

                &lt;!-- Footer --&gt;
                &lt;tr&gt;
                    &lt;td style="background-color:#263238; padding:18px; text-align:center;"&gt;
                        &lt;p style="color:#ffffff; margin:0; font-size:13px;"&gt;
                            SAP CPI Integration Test
                        &lt;/p&gt;
                        &lt;p style="color:#b0bec5; margin:5px 0 0; font-size:12px;"&gt;
                            This is an automated test email.
                        &lt;/p&gt;
                    &lt;/td&gt;
                &lt;/tr&gt;

            &lt;/table&gt;

        &lt;/td&gt;
    &lt;/tr&gt;
&lt;/table&gt;
```

&lt;/body&gt;
&lt;/html&gt;</value>
                </ifl:property>
